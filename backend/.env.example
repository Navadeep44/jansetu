# ---- JanSetu backend configuration (copy to .env). Everything is optional: ----
# ---- with no keys the platform runs fully offline using multilingual rules. ----
DATABASE_URL=sqlite:///./jansetu.db
# DATABASE_URL=postgresql+psycopg://jansetu:jansetu@localhost:5432/jansetu
HOUSEHOLD_SALT=change-me
AUTH_SECRET=change-me-too
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8000

# LLM (translation, extraction, NL questions, briefs): none | openai | anthropic | gemini
# "openai" works with ANY OpenAI-compatible server: OpenAI, Groq, Together, Sarvam, Ollama (http://localhost:11434/v1)
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# Speech-to-text for voice notes / IVR: none | openai (Whisper) ; Bhashini is used automatically when set
ASR_PROVIDER=none
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# Channels
TELEGRAM_BOT_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=jansetu-verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Federated privacy
K_ANONYMITY=5
DP_EPSILON=0
